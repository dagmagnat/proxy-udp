<%- include('partials_header', { pageTitle: 'Редактировать узел', pageSubtitle: 'Изменение параметров подключения узла', activePage: 'nodes' }) %>

<% if (message) { %>
  <div class="alert ok"><%= message %></div>
<% } %>

<% if (error) { %>
  <div class="alert err"><%= error %></div>
<% } %>

<div class="grid">
  <section class="card span-8">
    <h2>Параметры узла</h2>
    <div class="actions node-edit-top-actions" style="margin-bottom:14px;">
      <a class="link-btn secondary" href="/nodes/<%= node.id %>/edit?load_inbound=1">Загрузить параметры из 3x-ui</a>
      <form method="post" action="/nodes/<%= node.id %>/sync-clients" class="inline-form js-long-action" data-loading-title="Импортирую клиентов" data-loading-text="Читаю клиентов из выбранного 3x-ui inbound и добавляю недостающих в агрегатор." onsubmit="return confirm('Импортировать клиентов из этого inbound 3x-ui в агрегатор?')">
        <button type="submit" class="secondary">Импорт клиентов из 3x-ui</button>
      </form>
    </div>
    <form method="post" action="/nodes/<%= node.id %>/edit">
      <div class="form-grid">
        <div class="field">
          <label>Страна</label>
          <select name="country_code" required>
            <% countries.forEach(country => { %>
              <option value="<%= country.code %>" <%= country.code === node.country_code ? 'selected' : '' %>>
                <%= country.name_ru %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label>Доп. название узла</label>
          <input name="label_suffix" value="<%= node.label_suffix || '' %>" placeholder="например: 1, 2, Frankfurt, Hetzner" />
          <small class="hint">Например: Германия + 1 = 🇩🇪 Германия-1.</small>
        </div>

        <div class="field half">
          <label>Panel URL</label>
          <input name="panel_url" value="<%= node.panel_url %>" required />
        </div>

        <div class="field half">
          <label>Panel Path</label>
          <input name="panel_path" value="<%= node.panel_path || '' %>" />
        </div>

        <div class="field half">
          <label>Логин панели</label>
          <input name="username" value="<%= node.username %>" required />
        </div>

        <div class="field half">
          <label>Новый пароль панели</label>
          <input name="password" type="password" placeholder="Оставь пустым, чтобы не менять" />
        </div>

        <div class="field half">
          <label>Inbound ID</label>
          <input name="inbound_id" type="number" min="1" value="<%= node.inbound_id %>" required />
        </div>
      </div>

      <% if (inboundPreview) { %>
        <div class="field">
          <h3 style="margin:18px 0 0;">Частые параметры inbound из 3x-ui</h3>
          <small class="hint">Изменяй только то, что реально нужно для соединения. Перед сохранением лучше иметь backup 3x-ui. Поддержка API зависит от версии 3x-ui.</small>
        </div>
        <div class="form-grid inbound-editor-box">
          <div class="field third"><label>Port</label><input name="inbound_port" type="number" min="1" max="65535" value="<%= inboundPreview.port || '' %>" /></div>
          <div class="field third"><label>Protocol</label><input value="<%= inboundPreview.protocol || '' %>" readonly /></div>
          <div class="field third"><label>Transport / Security</label><input value="<%= inboundPreview.network || '-' %> / <%= inboundPreview.security || '-' %>" readonly /></div>
          <% if ((inboundPreview.network || '').toLowerCase() === 'xhttp') { %>
            <div class="field">
              <div class="alert ok">Обнаружен VLESS + XHTTP + REALITY. JSON-подписка будет собирать XHTTP-профиль автоматически. MUX и Sniffing остаются отдельными настройками и по умолчанию выключены.</div>
            </div>
          <% } %>
          <div class="field half"><label>Remark</label><input name="inbound_remark" value="<%= inboundPreview.remark || '' %>" /></div>
          <div class="field half"><label>SNI / ServerName</label><input name="inbound_sni" value="<%= inboundPreview.sni || '' %>" placeholder="www.apple.com" /></div>
          <div class="field half"><label>uTLS fingerprint</label><input name="inbound_fingerprint" value="<%= inboundPreview.fingerprint || '' %>" placeholder="chrome / firefox / safari" /></div>
          <div class="field half"><label>Short ID</label><input name="inbound_short_id" value="<%= inboundPreview.shortId || '' %>" /></div>
          <div class="field half"><label>SpiderX</label><input name="inbound_spider_x" value="<%= inboundPreview.spiderX || '/' %>" /></div>
          <% if ((inboundPreview.network || '').toLowerCase() === 'xhttp') { %>
            <div class="field half"><label>XHTTP path</label><input name="inbound_xhttp_path" value="<%= inboundPreview.xhttpPath || '/xhttp' %>" placeholder="/xhttp" /></div>
            <div class="field half"><label>XHTTP host</label><input name="inbound_xhttp_host" value="<%= inboundPreview.xhttpHost || '' %>" placeholder="пусто, если не нужен" /></div>
            <div class="field half"><label>XHTTP mode</label><input name="inbound_xhttp_mode" value="<%= inboundPreview.xhttpMode || 'stream-one' %>" placeholder="stream-one" /></div>
            <div class="field half"><label>XHTTP posts / bytes / interval</label><input name="inbound_xhttp_sc" value="<%= [inboundPreview.scMaxConcurrentPosts || 10, inboundPreview.scMaxEachPostBytes || 1000000, inboundPreview.scMinPostsIntervalMs || 30].join(', ') %>" placeholder="10, 1000000, 30" /></div>
            <div class="field">
              <label class="switch-row compact">
                <input type="checkbox" name="inbound_xhttp_fragment" value="1" <%= inboundPreview.dialerProxy === 'fragment' ? 'checked' : '' %> />
                <span><strong>XHTTP через fragment outbound</strong><small>Сохраняет/убирает sockopt.dialerProxy=fragment в inbound. Сам fragment outbound добавляется в JSON-подписку автоматически, если он нужен.</small></span>
              </label>
            </div>
          <% } %>
          <div class="field half"><label>Sniffing destOverride</label><input name="inbound_sniffing_dest" value="<%= inboundPreview.sniffingDestOverride || 'http, tls' %>" /></div>
          <div class="field">
            <label class="switch-row compact">
              <input type="checkbox" name="inbound_sniffing_enabled" value="1" <%= inboundPreview.sniffingEnabled ? 'checked' : '' %> />
              <span><strong>Sniffing в inbound</strong><small>Настройка именно 3x-ui/Xray, не Happ. Если не уверен — не меняй.</small></span>
            </label>
          </div>
          <div class="field">
            <label class="switch-row compact danger-option">
              <input type="checkbox" name="apply_inbound_settings" value="1" checked />
              <span><strong>Сохранить эти параметры в 3x-ui</strong><small>Включено по умолчанию: если ты изменил поля выше и нажал «Сохранить», агрегатор отправит изменения в выбранный inbound 3x-ui.</small></span>
            </label>
          </div>
        </div>
      <% } else { %>
        <div class="alert ok">Нажми «Загрузить параметры из 3x-ui», чтобы увидеть порт, REALITY/SNI/Short ID и sniffing текущего inbound.</div>
      <% } %>

      <div class="actions">
        <button type="submit">Сохранить</button>
        <a href="/nodes" class="link-btn secondary">Назад</a>
      </div>
    </form>
  </section>

  <section class="card span-4">
    <h2>Что меняется</h2>
    <div class="kv-list">
      <div class="kv-item">
        <strong>Доп. название</strong>
        <div class="muted">Добавляется к стране в названии сервера для клиента.</div>
      </div>
      <div class="kv-item">
        <strong>Panel URL и Path</strong>
        <div class="muted">Используются для входа в 3x-ui и API-вызовов.</div>
      </div>
      <div class="kv-item">
        <strong>Inbound ID</strong>
        <div class="muted">Определяет inbound, куда будут добавляться клиенты.</div>
      </div>
    </div>
  </section>
</div>

<%- include('partials_footer') %>
