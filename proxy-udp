cmd_exists() { command -v "$1" >/dev/null 2>&1; }

cls() {
  if [[ -t 1 ]]; then
    printf '\033[H\033[2J\033[3J'
  fi
}

pause() {
  echo
  read -r -p "$(tr_msg press_enter)" _ || true
}

say() { printf "%b\n" "$*"; }
info() { say "${CYAN}$*${RESET}"; }
success() { say "${SOFT_GREEN}$*${RESET}"; }
warn() { say "${YELLOW}$*${RESET}"; }
err() { say "${RED}$*${RESET}" >&2; }

trim() {
  local s="${1//$'\r'/}"
  s="$(printf "%s" "$s" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  printf "%s" "$s"
}

