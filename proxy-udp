install_command() {
  local dst="/usr/local/sbin/proxy-udp"
  cp "$0" "$dst"
  chmod 755 "$dst"
  cat > /etc/systemd/system/proxy-udp.service <<EOF_UNIT
[Unit]
Description=Proxy UDP iptables rules restore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$dst apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF_UNIT
  systemctl daemon-reload
  systemctl enable proxy-udp.service >/dev/null
  ok "$(t installed) $dst"
  ok "$(t autostart_enabled) proxy-udp.service"
}

main_menu() {
  local c rc
  require_root
  ensure_prereqs
  init_files
  load_config
  choose_language
  refresh_net_info
  apply_rules

  while true; do
    refresh_net_info
    header
    echo -e "${BOLD}$(t main_menu_title)${RESET}"
    echo "$(t create_proxy_menu)"
    echo -e "2) ${SOFT_GREEN}AntizapretVPN by GubernievS${RESET} — $([[ "$UI_LANG" == "ru" ]] && echo "preset портов без 80/443" || echo "port preset without 80/443")"
    echo "$(t delete_selected_menu)"
    echo "$(t delete_all_menu)"
    echo "$(t show_rules_menu)"
    echo "$(t port_check_menu)"
    echo "$(t settings_menu)"
    echo "$(t install_menu)"
    echo "0) $(t exit)"
    echo
    echo -e "${DIM}WAN: ${WAN_IF:-unknown}, IPv4: ${WAN_IP:-unknown}, NAT: $NAT_MODE, LANG: $UI_LANG${RESET}"
    echo
    c="$(read_nav "$(t choice)")"
    c="$(trim "$c")"
    cls
    rc=0
    case "$c" in
      1) create_proxy_custom || rc=$? ;;
      2) create_antizapret_preset || rc=$? ;;
      3) delete_selected_rules || rc=$? ;;
      4) delete_all_rules || rc=$? ;;
      5) show_iptables_rules || rc=$? ;;
      6) ports_check_menu || rc=$? ;;
      7) settings_menu || rc=$? ;;
      8) install_command; pause ;;
      0|"$MSG_BACK") exit 0 ;;
      "$MSG_MAIN") continue ;;
      *) warn "$(t invalid_choice)"; pause ;;
    esac
    [[ "$rc" -eq 10 ]] && continue
  done
}

case "${1:-}" in
  apply)
    require_root; ensure_prereqs; init_files; load_config; refresh_net_info; apply_rules
    ;;
  status)
    require_root; ensure_prereqs; init_files; load_config; refresh_net_info; print_rules; show_conntrack_status false
    ;;
  tune)
    require_root; ensure_prereqs; init_files; load_config; apply_tuning
    ;;
  *)
    main_menu
    ;;
esac
