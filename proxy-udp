  while true; do
    header >&2
    echo "$(t choose_protocol)" >&2
    echo "1) UDP" >&2
    echo "2) TCP" >&2
    echo "$(t both_protocols)" >&2
    echo "0) $(t back)" >&2
    echo "00) $(t main_menu_nav)" >&2
    echo >&2
    sel="$(read_nav "$(t choice)")"
    is_nav_back "$sel" && echo "$MSG_BACK" && return 0
    is_nav_main "$sel" && echo "$MSG_MAIN" && return 0
    case "$sel" in
      1) echo "udp"; return 0 ;;
      2) echo "tcp"; return 0 ;;
      3) echo "both"; return 0 ;;
      *) warn "$(t invalid_choice)"; pause ;;
    esac
  done
}

ports_from_input() {
  local input="$1" default_list="$2" cleaned="" p
  if [[ -z "${input// }" ]]; then
    input="$default_list"
  fi
  for p in $input; do
    if valid_port "$p"; then
      cleaned="$cleaned $p"
    else
      warn "$(t skip_bad_port) $p"
    fi
  done
  cleaned="$(uniq_words "$cleaned")"
  echo "$cleaned"
}

create_proxy_custom() {
  local target_ip proto_choice ports_in final_ports added=0 pr p
  while true; do
    header
    echo "$(t create_title)"
    echo
    target_ip="$(read_nav "$(t target_ip_prompt)")"
    is_nav_back "$target_ip" && return 0
    is_nav_main "$target_ip" && return 10
    if valid_ip "$target_ip"; then break; fi
    warn "$(t bad_ip_example)"
    pause
  done

  proto_choice="$(choose_protocol)"
  is_nav_back "$proto_choice" && return 0
  is_nav_main "$proto_choice" && return 10

  local protos=()
  case "$proto_choice" in
    udp) protos=(udp) ;;
    tcp) protos=(tcp) ;;
    both) protos=(udp tcp) ;;
  esac

  while true; do
    header
    echo "$(t default_ports) ${DEFAULT_PORTS[*]}"
    echo
    echo "$(t enter_default_ports)"
    echo "$(t custom_ports_hint)"
    echo
    ports_in="$(read_nav "$(t ports_prompt)")"
    is_nav_back "$ports_in" && return 0
    is_nav_main "$ports_in" && return 10
    final_ports="$(ports_from_input "$ports_in" "${DEFAULT_PORTS[*]}")"
    [[ -n "${final_ports// }" ]] && break
    warn "$(t no_valid_ports)"
    pause
  done

  for p in $final_ports; do
    for pr in "${protos[@]}"; do
      add_state_rule "$pr" "$p" "$target_ip" "$p" && added=1 || true
    done
  done

  if [[ "$added" -eq 1 ]]; then
    apply_rules
    ok "$(t rules_applied)"
  else
    warn "$(t nothing_added)"
  fi
  pause
}

create_antizapret_preset() {
  local target_ip mode p added=0
  while true; do
    header
    echo -e "${SOFT_GREEN}${BOLD}AntizapretVPN by GubernievS${RESET}"
    echo "$(t az_ports) ${DEFAULT_PORTS[*]}"
    echo "$(t az_no_80_443)"
    echo
    target_ip="$(read_nav "$(t az_target_prompt)")"
    is_nav_back "$target_ip" && return 0
    is_nav_main "$target_ip" && return 10
    if valid_ip "$target_ip"; then break; fi
    warn "$(t bad_ip)"
    pause
  done

  while true; do
    header
    echo -e "${SOFT_GREEN}${BOLD}AntizapretVPN by GubernievS${RESET}"
    echo "$(t az_mode_1)"
    echo "$(t az_mode_2)"
    echo "$(t az_mode_3)"
    echo "$(t az_mode_4)"
    echo "0) $(t back)"
    echo "00) $(t main_menu_nav)"
    echo
    mode="$(read_nav "$(t choice)")"
    is_nav_back "$mode" && return 0
    is_nav_main "$mode" && return 10
    case "$mode" in
      1)
        for p in "${ANTIZAPRET_OPENVPN_PORTS[@]}"; do
          add_state_rule tcp "$p" "$target_ip" "$p" && added=1 || true
          add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true
        done
        for p in "${ANTIZAPRET_WG_PORTS[@]}"; do
          add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true
        done
        break
        ;;
      2)
        for p in "${DEFAULT_PORTS[@]}"; do
          add_state_rule tcp "$p" "$target_ip" "$p" && added=1 || true
          add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true
        done
        break
        ;;
      3)
        for p in "${DEFAULT_PORTS[@]}"; do
          add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true
        done
        break
        ;;
      4)
        for p in "${DEFAULT_PORTS[@]}"; do
          add_state_rule tcp "$p" "$target_ip" "$p" && added=1 || true
        done
        break
        ;;
      *) warn "$(t invalid_choice)"; pause ;;
    esac
  done

  if [[ "$added" -eq 1 ]]; then
    apply_rules
    ok "$(t az_applied)"
  else
    warn "$(t nothing_added_maybe)"
  fi
  pause
}

delete_selected_rules() {
  local nums filtered="" n tmp
  header
  print_rules
  [[ -s "$STATE_FILE" ]] || { pause; return 0; }
  echo
  nums="$(read_nav "$(t delete_numbers_prompt)")"
  is_nav_back "$nums" && return 0
  is_nav_main "$nums" && return 10
  for n in $nums; do
    if [[ "$n" =~ ^[0-9]+$ ]]; then
      filtered="$filtered $n"
    else
      warn "$(t skip_bad_number) $n"
    fi
  done
  filtered="$(trim "$filtered")"
  [[ -z "$filtered" ]] && { warn "$(t no_valid_numbers)"; pause; return 0; }

  tmp="$(mktemp)"
  awk -v nums="$filtered" '
    BEGIN{split(nums,a," "); for(i in a) del[a[i]]=1}
    {if(!del[NR]) print $0}
  ' "$STATE_FILE" > "$tmp"
  cat "$tmp" > "$STATE_FILE"
  rm -f "$tmp"
  apply_rules
  ok "$(t delete_done)"
  pause
}

delete_all_rules() {
  local ans
  header
  warn "$(t delete_all_warning)"
  echo
  ans="$(read_nav "$(t confirm_yes)")"
  is_nav_back "$ans" && return 0
  is_nav_main "$ans" && return 10
  if [[ "$ans" == "YES" ]]; then
    : > "$STATE_FILE"
    apply_rules
    ok "$(t all_deleted)"
  else
    warn "$(t cancelled)"
  fi
  pause
}

show_iptables_rules() {
  header
  print_rules
