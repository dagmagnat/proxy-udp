show_conntrack_status() {
  local do_header="${1:-true}"
  [[ "$do_header" == "true" ]] && header
  echo "conntrack diagnostics:"
  [[ -r /proc/sys/net/netfilter/nf_conntrack_count ]] && echo "nf_conntrack_count: $(cat /proc/sys/net/netfilter/nf_conntrack_count)" || warn "nf_conntrack_count unavailable"
  [[ -r /proc/sys/net/netfilter/nf_conntrack_max ]] && echo "nf_conntrack_max  : $(cat /proc/sys/net/netfilter/nf_conntrack_max)"
  for k in nf_conntrack_udp_timeout nf_conntrack_udp_timeout_stream nf_conntrack_tcp_timeout_established; do
    [[ -r "/proc/sys/net/netfilter/$k" ]] && echo "$k: $(cat "/proc/sys/net/netfilter/$k")"
  done
  echo
  if cmd_exists conntrack; then conntrack -S 2>/dev/null || true; else warn "Install conntrack-tools for extended statistics: apt-get install -y conntrack"; fi
  [[ "$do_header" == "true" ]] && pause
}

