#!/usr/bin/env bash
set -euo pipefail

APP_NAME="MTProto Proxy Manager"
RAW_URL="https://raw.githubusercontent.com/dagmagnat/proxy-udp/main/mtproto-manager"
CONF="/etc/mtproto_manager.conf"
QUICK_CMD="/usr/local/bin/mtproto-go"
CONTAINER_NAME="mtproto-proxy"
IMAGE="telegrammessenger/proxy:latest"
VOLUME_NAME="mtproto-proxy-data"
DEFAULT_PORT="443"
DEFAULT_WORKERS="2"

SOFT_GREEN='\033[38;5;114m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'
MSG_BACK="__BACK__"
MSG_MAIN="__MAIN__"

LANGUAGE=""
CONF_PORT=""
CONF_SECRET=""
CONF_WORKERS=""
CONF_TAG=""
NAV_VALUE=""

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

trim() {
  local s="${1//$'\r'/}"
  s="$(printf "%s" "$s" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  printf "%s" "$s"
}

cls() { printf '\033[H\033[2J\033[3J'; }

text() {
  local key="$1"
  case "${LANGUAGE:-ru}:$key" in
    en:choose_lang) echo "Select interface language" ;;
    ru:choose_lang) echo "Выберите язык интерфейса" ;;
    en:choice) echo "Your choice: " ;;
    ru:choice) echo "Ваш выбор: " ;;
    en:exit) echo "Exit" ;;
    ru:exit) echo "Выход" ;;
    en:back) echo "Back" ;;
    ru:back) echo "Назад" ;;
    en:back_hint) echo "0 - back, 00 - main menu" ;;
    ru:back_hint) echo "0 — назад, 00 — главное меню" ;;
    en:main_menu) echo "Main menu" ;;
    ru:main_menu) echo "Главное меню" ;;
    en:create_start) echo "Create/start MTProto Proxy" ;;
    ru:create_start) echo "Создать/запустить MTProto Proxy" ;;
    en:stop) echo "Stop" ;;
    ru:stop) echo "Остановить" ;;
    en:restart) echo "Restart" ;;
    ru:restart) echo "Перезапустить" ;;
    en:status) echo "Status and statistics" ;;
    ru:status) echo "Статус и статистика" ;;
    en:show_link) echo "Show Telegram link" ;;
    ru:show_link) echo "Показать ссылку для Telegram" ;;
    en:change_port) echo "Change port" ;;
    ru:change_port) echo "Изменить порт" ;;
    en:regen_secret) echo "Regenerate secret" ;;
    ru:regen_secret) echo "Пересоздать secret" ;;
    en:workers) echo "Change workers" ;;
    ru:workers) echo "Изменить workers" ;;
    en:logs) echo "Logs" ;;
    ru:logs) echo "Логи" ;;
    en:update) echo "Update Docker image" ;;
    ru:update) echo "Обновить Docker-образ" ;;
    en:delete_all) echo "Delete everything" ;;
    ru:delete_all) echo "Удалить всё" ;;
    en:change_language) echo "Change language" ;;
    ru:change_language) echo "Сменить язык" ;;
    en:install_quick) echo "Install/update mtproto-go quick command" ;;
    ru:install_quick) echo "Установить/обновить быструю команду mtproto-go" ;;
    en:pause) echo "Press Enter to continue... " ;;
    ru:pause) echo "Нажмите Enter чтобы продолжить... " ;;
    en:not_root) echo "Run this script as root" ;;
    ru:not_root) echo "Запустите скрипт от root" ;;
    en:bad_choice) echo "Invalid choice." ;;
    ru:bad_choice) echo "Неверный выбор." ;;
    en:docker_missing) echo "Docker is not installed. Trying to install docker.io through apt..." ;;
    ru:docker_missing) echo "Docker не найден. Пытаюсь установить docker.io через apt..." ;;
    en:proxy_not_configured) echo "Proxy is not configured. Create/start it first." ;;
    ru:proxy_not_configured) echo "Прокси не настроен. Сначала создайте/запустите прокси." ;;
    en:port_prompt) echo "Port" ;;
    ru:port_prompt) echo "Порт" ;;
    en:new_port) echo "New port: " ;;
    ru:new_port) echo "Новый порт: " ;;
    en:bad_port) echo "Invalid port." ;;
    ru:bad_port) echo "Неверный порт." ;;
    en:port_busy) echo "Port is busy." ;;
    ru:port_busy) echo "Порт занят." ;;
    en:started) echo "MTProto Proxy started." ;;
    ru:started) echo "MTProto Proxy запущен." ;;
    en:stopped) echo "Container stopped." ;;
    ru:stopped) echo "Контейнер остановлен." ;;
    en:not_running) echo "Container is not running." ;;
    ru:not_running) echo "Контейнер не запущен." ;;
    en:restarted) echo "Restarted." ;;
    ru:restarted) echo "Перезапущено." ;;
    en:secret_updated) echo "Secret updated. Restarting..." ;;
    ru:secret_updated) echo "Secret обновлён. Выполняю перезапуск..." ;;
    en:workers_saved) echo "Workers saved. Restarting..." ;;
    ru:workers_saved) echo "Workers сохранён. Выполняю перезапуск..." ;;
    en:quick_done) echo "Quick command installed" ;;
    ru:quick_done) echo "Быстрая команда установлена" ;;
    en:confirm_yes) echo "Type YES to confirm: " ;;
    ru:confirm_yes) echo "Введите YES для подтверждения: " ;;
    en:cancelled) echo "Cancelled." ;;
    ru:cancelled) echo "Отменено." ;;
    en:deleted) echo "Deleted." ;;
    ru:deleted) echo "Удалено." ;;
    *) echo "$key" ;;
  esac
}

ok() { echo -e "${SOFT_GREEN}$*${RESET}"; }
warn() { echo -e "${YELLOW}$*${RESET}"; }
err() { echo -e "${RED}$*${RESET}" >&2; }
info() { echo -e "${CYAN}$*${RESET}"; }

pause() { echo; read -r -p "$(text pause)" _ || true; }

header() {
  cls
  echo -e "${SOFT_GREEN}${BOLD}========== ${APP_NAME} ==========${RESET}"
  echo -e "${DIM}$(text back_hint)${RESET}"
  echo
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    err "$(text not_root): sudo $0"
    exit 1
  fi
}

valid_port() {
  local p
  p="$(trim "${1:-}")"
  [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] || return 1
  ((p >= 1 && p <= 65535)) || return 1
}

valid_secret() {
  local s
  s="$(trim "${1:-}")"
  [[ "$s" =~ ^[0-9a-fA-F]{32}$ ]]
}

valid_workers() {
  local w
  w="$(trim "${1:-}")"
  [[ "$w" =~ ^[0-9]+$ ]] || return 1
  ((w >= 1 && w <= 64)) || return 1
}

init_conf() {
  if [[ ! -f "$CONF" ]]; then
    cat > "$CONF" <<EOF_CONF
# MTProto Proxy Manager config
LANGUAGE=
PORT=
SECRET=
WORKERS=$DEFAULT_WORKERS
TAG=
EOF_CONF
    chmod 600 "$CONF"
  fi
}

conf_reset() {
  CONF_PORT=""
  CONF_SECRET=""
  CONF_WORKERS=""
  CONF_TAG=""
}

conf_load() {
  conf_reset
  LANGUAGE=""
  [[ -f "$CONF" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "$line")"
    [[ -z "$line" || "${line:0:1}" == "#" || "$line" != *=* ]] && continue
    local key="${line%%=*}"
    local val="${line#*=}"
    key="$(trim "$key")"
    val="$(trim "$val")"
    case "$key" in
      LANGUAGE) [[ "$val" == "en" || "$val" == "ru" ]] && LANGUAGE="$val" ;;
      PORT) CONF_PORT="$val" ;;
      SECRET|KEY) CONF_SECRET="$val" ;;
      WORKERS) CONF_WORKERS="$val" ;;
      TAG) CONF_TAG="$val" ;;
    esac
  done < "$CONF"
  valid_port "$CONF_PORT" || CONF_PORT=""
  valid_secret "$CONF_SECRET" || CONF_SECRET=""
  valid_workers "$CONF_WORKERS" || CONF_WORKERS="$DEFAULT_WORKERS"
  [[ "$CONF_TAG" =~ ^[0-9a-fA-F]{32}$ ]] || CONF_TAG=""
}

conf_save() {
  local port="$1" secret="$2" workers="${3:-$DEFAULT_WORKERS}" tag="${4:-$CONF_TAG}" lang="${LANGUAGE:-}"
  cat > "$CONF" <<EOF_CONF
# MTProto Proxy Manager config
LANGUAGE=$lang
PORT=$port
SECRET=$secret
WORKERS=$workers
TAG=$tag
EOF_CONF
  chmod 600 "$CONF"
}

choose_language() {
  local sel current_port current_secret current_workers current_tag
  current_port="$CONF_PORT"
  current_secret="$CONF_SECRET"
  current_workers="${CONF_WORKERS:-$DEFAULT_WORKERS}"
  current_tag="$CONF_TAG"
  while true; do
    cls
    echo -e "${SOFT_GREEN}${BOLD}${APP_NAME}${RESET}"
    echo
    echo "$(text choose_lang):"
    echo "1) English"
    echo "2) Русский"
    echo "0) $(text exit)"
    echo
    read -r -p "$(text choice)" sel
    sel="$(trim "$sel")"
    case "$sel" in
      1) LANGUAGE="en"; conf_save "$current_port" "$current_secret" "$current_workers" "$current_tag"; cls; return 0 ;;
      2) LANGUAGE="ru"; conf_save "$current_port" "$current_secret" "$current_workers" "$current_tag"; cls; return 0 ;;
      0) exit 0 ;;
      *) warn "$(text bad_choice)"; sleep 1 ;;
    esac
  done
}

ensure_language() {
  conf_load
  if [[ "$LANGUAGE" != "en" && "$LANGUAGE" != "ru" ]]; then
    LANGUAGE="ru"
    choose_language
  fi
}

read_nav() {
  local prompt="$1" value
  read -r -p "$prompt" value || return 1
  value="$(trim "$value")"
  case "$value" in
    0) NAV_VALUE="$MSG_BACK" ;;
    00) NAV_VALUE="$MSG_MAIN" ;;
    *) NAV_VALUE="$value" ;;
  esac
}

is_back() { [[ "${NAV_VALUE:-}" == "$MSG_BACK" ]]; }
is_main() { [[ "${NAV_VALUE:-}" == "$MSG_MAIN" ]]; }

port_free() {
  local p="$1"
  if cmd_exists ss; then
    ! ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}$"
  elif cmd_exists netstat; then
    ! netstat -lnt 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}$"
  else
    return 0
  fi
}

rand_hex_16bytes() {
  if cmd_exists openssl; then
    openssl rand -hex 16
  else
    head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

pick_random_port() {
  local tries=0 p
  while true; do
    p=$((20000 + (RANDOM % 45000)))
    tries=$((tries + 1))
    if valid_port "$p" && port_free "$p"; then echo "$p"; return 0; fi
    ((tries >= 600)) && return 1
  done
}

ensure_docker() {
  if cmd_exists docker; then return 0; fi
  warn "$(text docker_missing)"
  if cmd_exists apt-get; then
    apt-get update -y
    apt-get install -y docker.io
    systemctl enable --now docker || true
  else
    err "Auto-install is available only on Debian/Ubuntu with apt. Install Docker manually."
    exit 1
  fi
  cmd_exists docker || { err "Docker installation failed."; exit 1; }
}

get_public_ip() {
  local ip=""
  if cmd_exists curl; then
    ip="$(curl -fsS --max-time 4 https://api.ipify.org 2>/dev/null || true)"
    [[ -z "$ip" ]] && ip="$(curl -fsS --max-time 4 https://ifconfig.me 2>/dev/null || true)"
  elif cmd_exists wget; then
    ip="$(wget -qO- --timeout=4 https://api.ipify.org 2>/dev/null || true)"
    [[ -z "$ip" ]] && ip="$(wget -qO- --timeout=4 https://ifconfig.me 2>/dev/null || true)"
  fi
  echo "$ip"
}

open_firewall_iptables() {
  local port="$1"
  if cmd_exists iptables; then
    iptables -w -C INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || iptables -w -I INPUT -p tcp --dport "$port" -j ACCEPT
  fi
}

remove_firewall_iptables() {
  local port="$1"
  if cmd_exists iptables; then
    while iptables -w -D INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null; do :; done
  fi
}

container_exists() { docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; }
container_running() { docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; }

show_link() {
  conf_load
  if [[ -z "$CONF_PORT" || -z "$CONF_SECRET" ]]; then
    warn "$(text proxy_not_configured)"
    return 0
  fi
  local ip
  ip="$(get_public_ip)"
  echo
  if [[ "$LANGUAGE" == "en" ]]; then
    echo "MTProto Proxy data:"
  else
    echo "Данные MTProto Proxy:"
  fi
  echo "Port   : $CONF_PORT"
  echo "Secret : $CONF_SECRET"
  echo "Workers: ${CONF_WORKERS:-$DEFAULT_WORKERS}"
  [[ -n "$CONF_TAG" ]] && echo "Tag    : $CONF_TAG"
  echo
  if [[ -n "$ip" ]]; then
    echo "Server IP: $ip"
    echo "Telegram link:"
    echo "tg://proxy?server=${ip}&port=${CONF_PORT}&secret=${CONF_SECRET}"
    echo
    echo "t.me link:"
    echo "https://t.me/proxy?server=${ip}&port=${CONF_PORT}&secret=${CONF_SECRET}"
  else
    warn "Could not detect public IP automatically. Insert your IP manually:"
    echo "tg://proxy?server=YOUR_IP&port=${CONF_PORT}&secret=${CONF_SECRET}"
  fi
}

ensure_config_interactive() {
  conf_load
  local port="${CONF_PORT:-}" secret="${CONF_SECRET:-}" workers="${CONF_WORKERS:-$DEFAULT_WORKERS}" tag="${CONF_TAG:-}" value random_port
  [[ -z "$secret" ]] && secret="$(rand_hex_16bytes)"
  [[ -z "$workers" ]] && workers="$DEFAULT_WORKERS"
  while [[ -z "$port" ]]; do
    read_nav "$(text port_prompt) [Enter = $DEFAULT_PORT]: "
    is_back && return 1
    is_main && return 10
    value="$NAV_VALUE"
    [[ -z "$value" ]] && value="$DEFAULT_PORT"
    if ! valid_port "$value"; then warn "$(text bad_port)"; continue; fi
    if ! port_free "$value"; then
      random_port="$(pick_random_port || true)"
      warn "$(text port_busy) Random free port: ${random_port:-not found}"
      [[ -n "$random_port" ]] && value="$random_port" || continue
    fi
    port="$value"
  done
  while true; do
    read_nav "Workers [Enter = $workers]: "
    is_back && return 1
    is_main && return 10
    value="$NAV_VALUE"
    [[ -z "$value" ]] && value="$workers"
    valid_workers "$value" && { workers="$value"; break; }
    warn "Workers must be a number from 1 to 64."
  done
  conf_save "$port" "$secret" "$workers" "$tag"
}

start_proxy() {
  ensure_docker
  header
  ensure_config_interactive || return $?
  conf_load
  if container_exists; then docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true; fi
  info "Pulling image $IMAGE..."
  docker pull "$IMAGE" >/dev/null || true
  local docker_args=(run -d --name "$CONTAINER_NAME" --restart unless-stopped -p "${CONF_PORT}:443" -v "${VOLUME_NAME}:/data" -e "SECRET=${CONF_SECRET}" -e "WORKERS=${CONF_WORKERS:-$DEFAULT_WORKERS}")
  [[ -n "$CONF_TAG" ]] && docker_args+=(-e "TAG=${CONF_TAG}")
  docker_args+=("$IMAGE")
  docker "${docker_args[@]}" >/dev/null
  open_firewall_iptables "$CONF_PORT"
  ok "$(text started)"
  show_link
  pause
}

stop_proxy() {
  ensure_docker
  header
  if container_running; then docker stop "$CONTAINER_NAME" >/dev/null; ok "$(text stopped)"; else warn "$(text not_running)"; fi
  pause
}

restart_proxy() {
  ensure_docker
  header
  if container_exists; then docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true; fi
  conf_load
  if [[ -z "$CONF_PORT" || -z "$CONF_SECRET" ]]; then warn "$(text proxy_not_configured)"; pause; return 0; fi
  docker pull "$IMAGE" >/dev/null || true
  local docker_args=(run -d --name "$CONTAINER_NAME" --restart unless-stopped -p "${CONF_PORT}:443" -v "${VOLUME_NAME}:/data" -e "SECRET=${CONF_SECRET}" -e "WORKERS=${CONF_WORKERS:-$DEFAULT_WORKERS}")
  [[ -n "$CONF_TAG" ]] && docker_args+=(-e "TAG=${CONF_TAG}")
  docker_args+=("$IMAGE")
  docker "${docker_args[@]}" >/dev/null
  open_firewall_iptables "$CONF_PORT"
  ok "$(text restarted)"
  show_link
  pause
}

status_proxy() {
  ensure_docker
  header
  conf_load
  echo "Docker container:"
  docker ps -a --filter "name=^/${CONTAINER_NAME}$" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" || true
  echo
  echo "Config: $CONF"
  echo "LANGUAGE=${LANGUAGE:-not set}"
  echo "PORT=${CONF_PORT:-not set}"
  echo "SECRET=${CONF_SECRET:-not set}"
  echo "WORKERS=${CONF_WORKERS:-$DEFAULT_WORKERS}"
  [[ -n "$CONF_TAG" ]] && echo "TAG=$CONF_TAG"
  echo "Quick command: $QUICK_CMD"
  echo
  if container_running; then
    info "Stats endpoint inside container:"
    docker exec "$CONTAINER_NAME" sh -c 'curl -fsS http://localhost:2398/stats 2>/dev/null | head -n 20 || true' || true
  fi
  pause
}

change_port() {
  local newport
  conf_load
  header
  if [[ -z "$CONF_SECRET" ]]; then warn "$(text proxy_not_configured)"; pause; return 0; fi
  while true; do
    echo "Current port: ${CONF_PORT:-not set}"
    read_nav "$(text new_port)"
    is_back && return 0
    is_main && return 10
    newport="$NAV_VALUE"
    valid_port "$newport" || { warn "$(text bad_port)"; continue; }
    port_free "$newport" || { warn "$(text port_busy)"; continue; }
    break
  done
  [[ -n "$CONF_PORT" ]] && remove_firewall_iptables "$CONF_PORT"
  conf_save "$newport" "$CONF_SECRET" "${CONF_WORKERS:-$DEFAULT_WORKERS}" "$CONF_TAG"
  ok "Port saved. Restarting..."
  restart_proxy
}

regenerate_secret() {
  conf_load
  header
  if [[ -z "$CONF_PORT" ]]; then warn "$(text proxy_not_configured)"; pause; return 0; fi
  local newsecret
  newsecret="$(rand_hex_16bytes)"
  conf_save "$CONF_PORT" "$newsecret" "${CONF_WORKERS:-$DEFAULT_WORKERS}" "$CONF_TAG"
  ok "$(text secret_updated)"
  restart_proxy
}

change_workers() {
  local value
  conf_load
  header
  if [[ -z "$CONF_PORT" || -z "$CONF_SECRET" ]]; then warn "$(text proxy_not_configured)"; pause; return 0; fi
  while true; do
    echo "Current workers: ${CONF_WORKERS:-$DEFAULT_WORKERS}"
    read_nav "New workers 1-64: "
    is_back && return 0
    is_main && return 10
    value="$NAV_VALUE"
    valid_workers "$value" && break
    warn "Invalid value."
  done
  conf_save "$CONF_PORT" "$CONF_SECRET" "$value" "$CONF_TAG"
  ok "$(text workers_saved)"
  restart_proxy
}

logs_proxy() {
  ensure_docker
  header
  if container_exists; then docker logs --tail=120 "$CONTAINER_NAME" || true; else warn "Container not found."; fi
  pause
}

update_image() {
  ensure_docker
  header
  docker pull "$IMAGE"
  ok "Docker image updated. Restart to apply."
  pause
}

uninstall_all() {
  ensure_docker
  header
  warn "This will remove container, config and Docker volume $VOLUME_NAME."
  read_nav "$(text confirm_yes)"
  is_back && return 0
  is_main && return 10
  if [[ "$NAV_VALUE" == "YES" ]]; then
    conf_load
    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
    docker volume rm "$VOLUME_NAME" >/dev/null 2>&1 || true
    [[ -n "$CONF_PORT" ]] && remove_firewall_iptables "$CONF_PORT"
    rm -f "$CONF"
    ok "$(text deleted)"
  else
    warn "$(text cancelled)"
  fi
  pause
}

download_or_copy_self() {
  local dst="$1" tmp src
  tmp="$(mktemp)"
  src="${BASH_SOURCE[0]}"

  # Prefer the local file when the script was started from /root/proxy-udp, /usr/local/bin/proxy-go, etc.
  # For bash <(wget ...), BASH_SOURCE is usually /dev/fd/*, so downloading from GitHub is safer.
  if [[ "$src" != /dev/fd/* && "$src" != /proc/*/fd/* && -r "$src" && -s "$src" ]]; then
    cat "$src" > "$tmp"
  elif cmd_exists wget && wget -qO "$tmp" --inet4-only "${RAW_URL}?$(date +%s)" 2>/dev/null && [[ -s "$tmp" ]]; then
    :
  elif cmd_exists curl && curl -fsSL "${RAW_URL}?$(date +%s)" -o "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    :
  else
    rm -f "$tmp"
    return 1
  fi

  install -m 755 "$tmp" "$dst"
  rm -f "$tmp"
}

install_quick_command() {
  require_root
  init_conf
  conf_load
  download_or_copy_self "$QUICK_CMD" || { err "Unable to install $QUICK_CMD"; return 1; }
  ok "$(text quick_done): $QUICK_CMD"
  ok "Run later with: mtproto-go"
}

main_menu() {
  local rc=0
  require_root
  init_conf
  ensure_language
  while true; do
    conf_load
    header
    echo -e "${BOLD}$(text main_menu)${RESET}"
    echo "1) $(text create_start)"
    echo "2) $(text stop)"
    echo "3) $(text restart)"
    echo "4) $(text status)"
    echo "5) $(text show_link)"
    echo "6) $(text change_port)"
    echo "7) $(text regen_secret)"
    echo "8) $(text workers)"
    echo "9) $(text logs)"
    echo "10) $(text update)"
    echo "11) $(text delete_all)"
    echo "12) $(text change_language)"
    echo "13) $(text install_quick)"
    echo "0) $(text exit)"
    echo
    echo -e "${DIM}Port: ${CONF_PORT:-not set}, workers: ${CONF_WORKERS:-$DEFAULT_WORKERS}, quick: $QUICK_CMD${RESET}"
    echo
    read_nav "$(text choice)"
    rc=0
    case "$NAV_VALUE" in
      1) start_proxy || rc=$? ;;
      2) stop_proxy || rc=$? ;;
      3) restart_proxy || rc=$? ;;
      4) status_proxy || rc=$? ;;
      5) header; show_link; pause ;;
      6) change_port || rc=$? ;;
      7) regenerate_secret || rc=$? ;;
      8) change_workers || rc=$? ;;
      9) logs_proxy || rc=$? ;;
      10) update_image || rc=$? ;;
      11) uninstall_all || rc=$? ;;
      12) choose_language ;;
      13) install_quick_command; pause ;;
      0|"$MSG_BACK") exit 0 ;;
      *) warn "$(text bad_choice)"; pause ;;
    esac
    [[ "$rc" -eq 10 ]] && continue
  done
}

case "${1:-}" in
  start) LANGUAGE="ru"; require_root; init_conf; conf_load; start_proxy ;;
  restart) LANGUAGE="ru"; require_root; init_conf; conf_load; restart_proxy ;;
  stop) LANGUAGE="ru"; require_root; init_conf; conf_load; stop_proxy ;;
  status) LANGUAGE="ru"; require_root; init_conf; conf_load; status_proxy ;;
  logs) LANGUAGE="ru"; require_root; init_conf; conf_load; logs_proxy ;;
  install-go|install|quick) LANGUAGE="ru"; require_root; init_conf; conf_load; install_quick_command ;;
  language) require_root; init_conf; conf_load; choose_language ;;
  *) main_menu ;;
esac
