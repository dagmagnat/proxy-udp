ok() { echo -e "${SOFT_GREEN}$*${RESET}"; }
warn() { echo -e "${YELLOW}$*${RESET}"; }
err() { echo -e "${RED}$*${RESET}" >&2; }
info() { echo -e "${CYAN}$*${RESET}"; }

pause() {
  echo
  read -r -p "$(text pause)" _ || true
}

header() {
  cls
  echo -e "${SOFT_GREEN}${BOLD}========== ${APP_NAME} ==========${RESET}"
  echo -e "${DIM}$(text back_hint)${RESET}"
  echo
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    err "$(text not_root): sudo $0"
    exit 1
  fi
}

ensure_prereqs() {
  local missing=()
  for c in iptables ip sysctl awk grep sed sort uniq nl; do
    cmd_exists "$c" || missing+=("$c")
  done
  if ((${#missing[@]} > 0)); then
    err "Missing dependencies: ${missing[*]}"
    err "apt-get update && apt-get install -y iptables iproute2 coreutils gawk grep sed"
    exit 1
  fi
}

init_files() {
  if [[ ! -f "$STATE_FILE" ]]; then
    touch "$STATE_FILE"
    chmod 600 "$STATE_FILE"
  fi
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat > "$CONFIG_FILE" <<EOF_CONF
# Proxy UDP manager config
LANGUAGE=
NAT_MODE=snat
EOF_CONF
    chmod 600 "$CONFIG_FILE"
  fi
}

load_config() {
  LANGUAGE=""
  NAT_MODE="snat"
  [[ -f "$CONFIG_FILE" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "$line")"
    [[ -z "$line" || "${line:0:1}" == "#" || "$line" != *=* ]] && continue
    local key="${line%%=*}"
    local val="${line#*=}"
    key="$(trim "$key")"
    val="$(trim "$val")"
    case "$key" in
      LANGUAGE) [[ "$val" == "en" || "$val" == "ru" ]] && LANGUAGE="$val" ;;
      NAT_MODE) [[ "$val" == "snat" || "$val" == "masquerade" ]] && NAT_MODE="$val" ;;
    esac
  done < "$CONFIG_FILE"
}

save_config() {
  cat > "$CONFIG_FILE" <<EOF_CONF
# Proxy UDP manager config
LANGUAGE=${LANGUAGE:-}
NAT_MODE=$NAT_MODE
EOF_CONF
  chmod 600 "$CONFIG_FILE"
}

choose_language() {
  local sel
  while true; do
    cls
    echo -e "${SOFT_GREEN}${BOLD}${APP_NAME}${RESET}"
    echo
    echo "$(text choose_lang):"
    echo "1) English"
    echo "2) Русский"
    echo "0) $(text exit)"
    echo
    read -r -p "$(text choice)" sel
    sel="$(trim "$sel")"
    case "$sel" in
      1) LANGUAGE="en"; save_config; cls; return 0 ;;
      2) LANGUAGE="ru"; save_config; cls; return 0 ;;
      0) exit 0 ;;
      *) warn "$(text bad_choice)"; sleep 1 ;;
    esac
  done
}

ensure_language() {
  load_config
  if [[ "$LANGUAGE" != "en" && "$LANGUAGE" != "ru" ]]; then
    LANGUAGE="ru"
    choose_language
  fi
}

read_nav() {
  local prompt="$1" value
  read -r -p "$prompt" value || return 1
  value="$(trim "$value")"
  case "$value" in
    0) NAV_VALUE="$MSG_BACK" ;;
    00) NAV_VALUE="$MSG_MAIN" ;;
    *) NAV_VALUE="$value" ;;
  esac
}

is_back() { [[ "${NAV_VALUE:-}" == "$MSG_BACK" ]]; }
is_main() { [[ "${NAV_VALUE:-}" == "$MSG_MAIN" ]]; }

valid_ip() {
  local ip
  ip="$(trim "${1:-}")"
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  local o1 o2 o3 o4
  IFS='.' read -r o1 o2 o3 o4 <<< "$ip"
  for o in "$o1" "$o2" "$o3" "$o4"; do
    [[ "$o" =~ ^[0-9]+$ ]] || return 1
    ((o >= 0 && o <= 255)) || return 1
  done
}

valid_port() {
  local p
  p="$(trim "${1:-}")"
  [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] || return 1
  ((p >= 1 && p <= 65535)) || return 1
}

uniq_words() {
  awk '{for(i=1;i<=NF;i++){if(!seen[$i]++){out=out (out?OFS:"") $i}}} END{print out}' <<< "$*"
}

detect_wan_if() {
  local ifn
  ifn="$(ip route get 1.1.1.1 2>/dev/null | awk '/dev/ {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -n1)"
  if [[ -n "${ifn:-}" ]]; then
    echo "$ifn"
  else
    ip -br link | awk '$1 !~ /^lo$/ {print $1; exit}'
  fi
}

detect_wan_ip() {
  local ipaddr
  ipaddr="$(ip route get 1.1.1.1 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -n1)"
  if [[ -n "${ipaddr:-}" ]]; then
    echo "$ipaddr"
  else
    ip -4 addr show dev "$WAN_IF" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1
  fi
}

refresh_net_info() {
  WAN_IF="$(detect_wan_if)"
  WAN_IP="$(detect_wan_ip)"
}

normalize_state_file() {
  local tmp
  tmp="$(mktemp)"
  awk '
    NF >= 3 && $1 !~ /^#/ {
      proto=tolower($1); sport=$2; tip=$3; dport=$4;
      if(dport=="") dport=sport;
      if((proto=="tcp" || proto=="udp") && sport ~ /^[0-9]+$/ && dport ~ /^[0-9]+$/) {
        key=proto " " sport " " tip " " dport;
        if(!seen[key]++) print proto, sport, tip, dport;
      }
    }
  ' "$STATE_FILE" > "$tmp"
  cat "$tmp" > "$STATE_FILE"
  rm -f "$tmp"
  chmod 600 "$STATE_FILE"
}

enable_ip_forward() {
  sysctl -w net.ipv4.ip_forward=1 >/dev/null || true
}

ensure_chains() {
  iptables -w -t nat -N "$CHAIN_NAT" 2>/dev/null || true
  iptables -w -t nat -N "$CHAIN_POST" 2>/dev/null || true
  iptables -w -N "$CHAIN_FWD" 2>/dev/null || true
  iptables -w -t nat -F "$CHAIN_NAT"
  iptables -w -t nat -F "$CHAIN_POST"
  iptables -w -F "$CHAIN_FWD"
  while iptables -w -t nat -D PREROUTING -i "$WAN_IF" -j "$CHAIN_NAT" 2>/dev/null; do :; done
  iptables -w -t nat -A PREROUTING -i "$WAN_IF" -j "$CHAIN_NAT"
  while iptables -w -t nat -D POSTROUTING -j "$CHAIN_POST" 2>/dev/null; do :; done
  iptables -w -t nat -A POSTROUTING -j "$CHAIN_POST"
  while iptables -w -D FORWARD -j "$CHAIN_FWD" 2>/dev/null; do :; done
  iptables -w -A FORWARD -j "$CHAIN_FWD"
}

apply_rules() {
  refresh_net_info
  load_config
  enable_ip_forward
  normalize_state_file
  ensure_chains
  local targets=""
  while read -r proto sport tip dport; do
    [[ -z "${proto:-}" || "${proto:0:1}" == "#" ]] && continue
    [[ -z "${sport:-}" || -z "${tip:-}" ]] && continue
    dport="${dport:-$sport}"
    iptables -w -t nat -A "$CHAIN_NAT" -p "$proto" --dport "$sport" -j DNAT --to-destination "${tip}:${dport}"
    iptables -w -A "$CHAIN_FWD" -p "$proto" -d "$tip" --dport "$dport" -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT
    iptables -w -A "$CHAIN_FWD" -p "$proto" -s "$tip" --sport "$dport" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    targets="$targets $tip"
  done < "$STATE_FILE"
  targets="$(uniq_words "$targets")"
  for tip in $targets; do
    if [[ "$NAT_MODE" == "snat" && -n "${WAN_IP:-}" ]]; then
      iptables -w -t nat -A "$CHAIN_POST" -o "$WAN_IF" -d "$tip" -j SNAT --to-source "$WAN_IP"
    else
      iptables -w -t nat -A "$CHAIN_POST" -o "$WAN_IF" -d "$tip" -j MASQUERADE
    fi
  done
}

add_state_rule() {
  local proto="$1" sport="$2" tip="$3" dport="${4:-$2}"
  if grep -qE "^${proto}[[:space:]]+${sport}[[:space:]]+${tip}[[:space:]]+${dport}([[:space:]]|$)" "$STATE_FILE" 2>/dev/null; then
    warn "$(text exists): $proto $sport -> $tip:$dport"
    return 1
  fi
  echo "$proto $sport $tip $dport" >> "$STATE_FILE"
  ok "$(text added): $proto $sport -> $tip:$dport"
}

print_rules() {
  normalize_state_file
  if [[ ! -s "$STATE_FILE" ]]; then
    warn "$(text no_rules)"
    return 0
  fi
  echo -e "${BOLD}$(text current_rules):${RESET}"
  awk '{printf "%2d) %-3s %-5s -> %s:%s\n", NR, $1, $2, $3, $4}' "$STATE_FILE"
}

choose_protocol() {
  local sel
  CHOSEN_PROTOCOL=""
  while true; do
    header
    echo "$(text choose_proto):"
    echo "1) UDP"
    echo "2) TCP"
    echo "3) $(text udp_tcp)"
    echo "0) $(text back)"
    echo "00) $(text main_menu)"
    echo
    read_nav "$(text choice)"
    is_back && return 1
    is_main && return 10
    sel="$NAV_VALUE"
    case "$sel" in
      1) CHOSEN_PROTOCOL="udp"; return 0 ;;
      2) CHOSEN_PROTOCOL="tcp"; return 0 ;;
      3) CHOSEN_PROTOCOL="both"; return 0 ;;
      *) warn "$(text bad_choice)"; pause ;;
    esac
  done
}

ports_from_input() {
  local input="$1" default_list="$2" cleaned="" p
  if [[ -z "${input// }" ]]; then input="$default_list"; fi
  for p in $input; do
    if valid_port "$p"; then cleaned="$cleaned $p"; else warn "Invalid port skipped: $p"; fi
  done
  uniq_words "$cleaned"
}

create_proxy_custom() {
  local target_ip ports_in final_ports added=0 pr p
  while true; do
    header
    echo "$(text create_proxy)"
    echo
    read_nav "$(text target_ip)"
    is_back && return 0
    is_main && return 10
    target_ip="$NAV_VALUE"
    valid_ip "$target_ip" && break
    warn "$(text bad_ip)"
    pause
  done
  choose_protocol || return $?
  local protos=()
  case "$CHOSEN_PROTOCOL" in
    udp) protos=(udp) ;;
    tcp) protos=(tcp) ;;
    both) protos=(udp tcp) ;;
  esac
  while true; do
    header
    echo "$(text default_ports): ${DEFAULT_PORTS[*]}"
    echo
    read_nav "$(text ports_prompt)"
    is_back && return 0
    is_main && return 10
    ports_in="$NAV_VALUE"
    final_ports="$(ports_from_input "$ports_in" "${DEFAULT_PORTS[*]}")"
    [[ -n "${final_ports// }" ]] && break
    warn "No valid ports."
    pause
  done
  for p in $final_ports; do
    for pr in "${protos[@]}"; do
      add_state_rule "$pr" "$p" "$target_ip" "$p" && added=1 || true
    done
  done
  if [[ "$added" -eq 1 ]]; then apply_rules; ok "$(text applied)"; else warn "Nothing added."; fi
  pause
}

create_antizapret_preset() {
  local target_ip mode p added=0
  while true; do
    header
    echo -e "${SOFT_GREEN}${BOLD}AntizapretVPN by GubernievS${RESET}"
    echo "Preset ports: ${DEFAULT_PORTS[*]}"
    echo "80 and 443 are not added by default."
    echo
    read_nav "$(text target_ip)"
    is_back && return 0
    is_main && return 10
    target_ip="$NAV_VALUE"
    valid_ip "$target_ip" && break
    warn "$(text bad_ip)"
    pause
  done
  while true; do
    header
    echo -e "${SOFT_GREEN}${BOLD}AntizapretVPN by GubernievS${RESET}"
    if [[ "$LANGUAGE" == "en" ]]; then
      echo "1) Recommended: OpenVPN TCP+UDP, WireGuard/AmneziaWG UDP"
      echo "2) All preset ports TCP+UDP"
      echo "3) All preset ports UDP only"
      echo "4) All preset ports TCP only"
    else
      echo "1) Рекомендуемый режим: OpenVPN TCP+UDP, WireGuard/AmneziaWG UDP"
      echo "2) Все preset-порты TCP+UDP"
      echo "3) Все preset-порты только UDP"
      echo "4) Все preset-порты только TCP"
    fi
    echo "0) $(text back)"
    echo "00) $(text main_menu)"
    echo
    read_nav "$(text choice)"
    is_back && return 0
    is_main && return 10
    mode="$NAV_VALUE"
    case "$mode" in
      1)
        for p in "${ANTIZAPRET_OPENVPN_PORTS[@]}"; do
          add_state_rule tcp "$p" "$target_ip" "$p" && added=1 || true
          add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true
        done
        for p in "${ANTIZAPRET_WG_PORTS[@]}"; do add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true; done
        break ;;
      2)
        for p in "${DEFAULT_PORTS[@]}"; do
          add_state_rule tcp "$p" "$target_ip" "$p" && added=1 || true
          add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true
        done
        break ;;
      3) for p in "${DEFAULT_PORTS[@]}"; do add_state_rule udp "$p" "$target_ip" "$p" && added=1 || true; done; break ;;
      4) for p in "${DEFAULT_PORTS[@]}"; do add_state_rule tcp "$p" "$target_ip" "$p" && added=1 || true; done; break ;;
      *) warn "$(text bad_choice)"; pause ;;
    esac
  done
  if [[ "$added" -eq 1 ]]; then apply_rules; ok "$(text applied)"; else warn "Nothing added."; fi
  pause
}

delete_selected_rules() {
  local nums filtered="" n tmp
  header
  print_rules
  [[ -s "$STATE_FILE" ]] || { pause; return 0; }
  echo
  read_nav "$(text delete_numbers)"
  is_back && return 0
  is_main && return 10
  nums="$NAV_VALUE"
  for n in $nums; do
    [[ "$n" =~ ^[0-9]+$ ]] && filtered="$filtered $n" || warn "Skipped invalid number: $n"
  done
  filtered="$(trim "$filtered")"
  [[ -z "$filtered" ]] && { warn "No valid numbers."; pause; return 0; }
  tmp="$(mktemp)"
  awk -v nums="$filtered" 'BEGIN{split(nums,a," "); for(i in a) del[a[i]]=1} {if(!del[NR]) print $0}' "$STATE_FILE" > "$tmp"
  cat "$tmp" > "$STATE_FILE"
  rm -f "$tmp"
  apply_rules
  ok "$(text deleted)"
  pause
}

delete_all_rules() {
  header
  warn "This will remove all rules managed by ${APP_NAME}. Other firewall rules are not touched."
  echo
  read_nav "$(text confirm_yes)"
  is_back && return 0
  is_main && return 10
  if [[ "$NAV_VALUE" == "YES" ]]; then
    : > "$STATE_FILE"
    apply_rules
    ok "$(text all_deleted)"
  else
    warn "$(text cancelled)"
  fi
  pause
}

show_iptables_rules() {
  header
  print_rules
  echo
  info "WAN interface: ${WAN_IF:-unknown}"
  info "WAN IPv4     : ${WAN_IP:-unknown}"
  info "NAT mode     : $NAT_MODE"
  echo
  echo "iptables NAT chain:"
  iptables -w -t nat -S "$CHAIN_NAT" 2>/dev/null || true
  echo
  echo "iptables FORWARD chain:"
  iptables -w -S "$CHAIN_FWD" 2>/dev/null || true
  pause
}

check_tcp() {
  local host="$1" port="$2"
  if timeout 3 bash -c "</dev/tcp/${host}/${port}" 2>/dev/null; then ok "TCP $host:$port OK"; else err "TCP $host:$port failed/closed"; fi
}

check_udp() {
  local host="$1" port="$2"
  if cmd_exists nc; then
    if timeout 4 nc -zuv -w2 "$host" "$port" >/tmp/proxy_udp_nc.out 2>&1; then ok "UDP $host:$port probe OK"; else warn "UDP $host:$port: no clear response; UDP cannot be checked reliably without app reply"; fi
  else
    warn "UDP $host:$port: install netcat-openbsd for UDP probe. UDP checks are conditional."
  fi
}

check_current_rules() {
  header
  normalize_state_file
  if [[ ! -s "$STATE_FILE" ]]; then warn "$(text no_rules)"; pause; return 0; fi
  while read -r proto sport tip dport; do
    dport="${dport:-$sport}"
    [[ "$proto" == "tcp" ]] && check_tcp "$tip" "$dport"
    [[ "$proto" == "udp" ]] && check_udp "$tip" "$dport"
  done < "$STATE_FILE"
  pause
}

check_custom_ports() {
  local target_ip ports_in ports p
  while true; do
    header
    read_nav "$(text target_ip)"
    is_back && return 0
    is_main && return 10
    target_ip="$NAV_VALUE"
    valid_ip "$target_ip" && break
    warn "$(text bad_ip)"
    pause
  done
  choose_protocol || return $?
  while true; do
    header
    read_nav "$(text ports_prompt)"
    is_back && return 0
    is_main && return 10
    ports_in="$NAV_VALUE"
    ports="$(ports_from_input "$ports_in" "${DEFAULT_PORTS[*]}")"
    [[ -n "${ports// }" ]] && break
    warn "No valid ports."
    pause
  done
  header
  for p in $ports; do
    case "$CHOSEN_PROTOCOL" in
      tcp) check_tcp "$target_ip" "$p" ;;
      udp) check_udp "$target_ip" "$p" ;;
      both) check_tcp "$target_ip" "$p"; check_udp "$target_ip" "$p" ;;
    esac
  done
  pause
}

