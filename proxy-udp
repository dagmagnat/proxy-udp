require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    err "$(tr_msg need_root)"
    exit 1
  fi
}

ensure_prereqs() {
  cmd_exists iptables || { err "$(tr_msg not_found_iptables)"; exit 1; }
  cmd_exists ip || { err "$(tr_msg not_found_ip)"; exit 1; }
  cmd_exists awk || { err "awk not found"; exit 1; }
  cmd_exists grep || { err "grep not found"; exit 1; }
  cmd_exists sed || { err "sed not found"; exit 1; }
}

safe_mkdir_files() {
  [[ -f "$STATE_FILE" ]] || { touch "$STATE_FILE"; chmod 600 "$STATE_FILE"; }
  [[ -f "$CONF_FILE" ]] || { touch "$CONF_FILE"; chmod 600 "$CONF_FILE"; }
}

conf_load() {
  [[ -f "$CONF_FILE" ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "${line:0:1}" == "#" || "$line" != *=* ]] && continue
    key="$(trim "${line%%=*}")"
    val="$(trim "${line#*=}")"
    case "$key" in
      LANGUAGE) [[ "$val" == "en" || "$val" == "ru" ]] && LANGUAGE="$val" ;;
      NAT_MODE) [[ "$val" == "masquerade" || "$val" == "snat" ]] && NAT_MODE="$val" ;;
      SNAT_IP) SNAT_IP="$val" ;;
      WAN_IF) WAN_IF="$val" ;;
    esac
  done < "$CONF_FILE"
}

conf_save() {
  cat > "$CONF_FILE" <<EOF_CONF
# Proxy UDP config
LANGUAGE=${LANGUAGE:-ru}
NAT_MODE=${NAT_MODE:-masquerade}
SNAT_IP=${SNAT_IP:-}
WAN_IF=${WAN_IF:-}
EOF_CONF
  chmod 600 "$CONF_FILE"
}

choose_language() {
  while true; do
    cls
    echo
    say "${GREEN}${BOLD}Proxy UDP${RESET}"
    echo "1) English"
    echo "2) Русский"
    echo "0) Выход / Exit"
    echo
    read -r -p "Choose language / Выберите язык: " choice
    case "$(trim "$choice")" in
      1) LANGUAGE="en"; conf_save; cls; return 0 ;;
      2) LANGUAGE="ru"; conf_save; cls; return 0 ;;
      0) exit 0 ;;
      *) echo "Invalid choice / Неверный выбор"; sleep 1 ;;
    esac
  done
}

ensure_language() {
  conf_load
  if [[ -z "${LANGUAGE:-}" ]]; then
    choose_language
  fi
}

valid_ip() {
  local ip="$1" o1 o2 o3 o4
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS='.' read -r o1 o2 o3 o4 <<< "$ip"
  for o in "$o1" "$o2" "$o3" "$o4"; do
    [[ "$o" =~ ^[0-9]+$ ]] || return 1
    (( o >= 0 && o <= 255 )) || return 1
  done
  return 0
}

valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  (( p >= 1 && p <= 65535 )) || return 1
  return 0
}

uniq_ports() {
  awk '
    {
      for (i=1;i<=NF;i++) {
        if (!seen[$i]++) out = out (out ? OFS : "") $i
      }
    }
    END { print out }
  ' <<< "$1"
}

detect_wan_if() {
  local ifn
  if [[ -n "${WAN_IF:-}" ]] && ip link show "$WAN_IF" >/dev/null 2>&1; then
    echo "$WAN_IF"
    return 0
  fi
  ifn="$(ip route get 1.1.1.1 2>/dev/null | awk '/dev/ {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -n1)"
  if [[ -n "${ifn:-}" ]]; then
    echo "$ifn"
  else
    ip -br link | awk '$1 !~ /^lo/ {print $1; exit}'
  fi
}

detect_src_ip() {
  ip route get 1.1.1.1 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -n1
}

enable_ip_forward() {
  sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
  if [[ -f /etc/sysctl.conf ]] && ! grep -q '^net.ipv4.ip_forward=1' /etc/sysctl.conf 2>/dev/null; then
    echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
  fi
}

iptables_del_all() {
  local table="$1" chain="$2" jump="$3"
  while iptables -w -t "$table" -D "$chain" $jump 2>/dev/null; do :; done
}

iptables_filter_del_all() {
  local chain="$1" jump="$2"
  while iptables -w -D "$chain" $jump 2>/dev/null; do :; done
}

apply_rules() {
  require_root
  ensure_prereqs
  safe_mkdir_files
  conf_load
  local wan
  wan="$(detect_wan_if)"
  [[ -n "$wan" ]] || { err "WAN interface not found"; exit 1; }
  WAN_IF="$wan"
  conf_save
  enable_ip_forward

  iptables -w -t nat -N "$CHAIN_NAT" 2>/dev/null || true
  iptables -w -t nat -F "$CHAIN_NAT"
  iptables -w -t nat -N "$CHAIN_POST" 2>/dev/null || true
  iptables -w -t nat -F "$CHAIN_POST"
  iptables -w -N "$CHAIN_FWD" 2>/dev/null || true
  iptables -w -F "$CHAIN_FWD"

  iptables_del_all nat PREROUTING "-i $wan -j $CHAIN_NAT"
  iptables -w -t nat -A PREROUTING -i "$wan" -j "$CHAIN_NAT"

  iptables_del_all nat POSTROUTING "-j $CHAIN_POST"
  iptables -w -t nat -A POSTROUTING -j "$CHAIN_POST"

  iptables_filter_del_all FORWARD "-j $CHAIN_FWD"
  iptables -w -A FORWARD -j "$CHAIN_FWD"

  local proto port tip line unique_targets=""
  while read -r proto port tip extra || [[ -n "${proto:-}" ]]; do
    [[ -z "${proto:-}" || "${proto:0:1}" == "#" ]] && continue
    [[ -z "${port:-}" || -z "${tip:-}" ]] && continue
    [[ "$proto" == "udp" || "$proto" == "tcp" ]] || continue
    valid_port "$port" || continue
    valid_ip "$tip" || continue

    iptables -w -t nat -A "$CHAIN_NAT" -p "$proto" --dport "$port" -j DNAT --to-destination "${tip}:${port}"
    iptables -w -A "$CHAIN_FWD" -p "$proto" -d "$tip" --dport "$port" -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT
    iptables -w -A "$CHAIN_FWD" -p "$proto" -s "$tip" --sport "$port" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    unique_targets="$unique_targets $tip"
  done < "$STATE_FILE"

  local targets
  targets="$(uniq_ports "$unique_targets")"
  local src_ip="${SNAT_IP:-}"
  if [[ "$NAT_MODE" == "snat" ]]; then
    [[ -n "$src_ip" ]] || src_ip="$(detect_src_ip)"
  fi

  local t
  for t in $targets; do
    if [[ "$NAT_MODE" == "snat" && -n "$src_ip" ]] && valid_ip "$src_ip"; then
      iptables -w -t nat -A "$CHAIN_POST" -d "$t" -j SNAT --to-source "$src_ip"
    else
      iptables -w -t nat -A "$CHAIN_POST" -o "$wan" -d "$t" -j MASQUERADE
    fi
  done
}

print_rules() {
  safe_mkdir_files
  if [[ ! -s "$STATE_FILE" ]]; then
    warn "$(tr_msg no_rules)"
    return 0
  fi
  echo "$(tr_msg current_rules):"
  nl -w2 -s') ' "$STATE_FILE"
}

choose_protocol() {
  local sel
  while true; do
    cls >&2
    echo >&2
    say "${GREEN}$(tr_msg choose_proto)${RESET}" >&2
    echo "1) $(tr_msg udp)" >&2
    echo "2) $(tr_msg tcp)" >&2
    echo "3) $(tr_msg both)" >&2
    echo "0) $(tr_msg back)" >&2
    echo "00) $(tr_msg main_menu)" >&2
    echo >&2
    read -r -p "$(tr_msg choose_item)" sel >&2
    case "$(trim "$sel")" in
      1) echo "udp"; return 0 ;;
      2) echo "tcp"; return 0 ;;
      3) echo "both"; return 0 ;;
      0) echo "back"; return 0 ;;
      00) echo "main"; return 0 ;;
      *) echo "$(tr_msg invalid_choice)" >&2; sleep 1 ;;
    esac
  done
}

add_rules_for_ports() {
  local target_ip="$1" proto_choice="$2" ports="$3"
  local protos=() p pr added_any=0
  case "$proto_choice" in
    udp) protos=(udp) ;;
    tcp) protos=(tcp) ;;
    both) protos=(udp tcp) ;;
    *) return 1 ;;
  esac

  for p in $ports; do
    for pr in "${protos[@]}"; do
      if grep -qE "^${pr}[[:space:]]+${p}[[:space:]]+${target_ip}$" "$STATE_FILE" 2>/dev/null; then
        warn "$(tr_msg already_exists): $pr $p -> $target_ip"
      else
        echo "${pr} ${p} ${target_ip}" >> "$STATE_FILE"
        success "$(tr_msg added): $pr $p -> $target_ip"
        added_any=1
      fi
    done
  done

  if [[ "$added_any" -eq 1 ]]; then
    apply_rules
    success "$(tr_msg done)"
  else
    warn "$(tr_msg nothing_added)"
  fi
}

create_proxy_menu() {
  safe_mkdir_files
  local target_ip proto_choice ports_in selected_ports cleaned p final_ports
  while true; do
    cls
    read -r -p "$(tr_msg target_ip_prompt)" target_ip
    target_ip="$(trim "$target_ip")"
    case "$target_ip" in
      0) return 0 ;;
      00) return 0 ;;
    esac
    if ! valid_ip "$target_ip"; then
      err "$(tr_msg invalid_ip)"
      sleep 1
      continue
    fi
    break
  done

  proto_choice="$(choose_protocol)"
  [[ "$proto_choice" == "back" || "$proto_choice" == "main" ]] && return 0

  while true; do
    cls
    echo "$(tr_msg default_ports): ${DEFAULT_PORTS[*]}"
    echo
    echo "$(tr_msg ports_logic1)"
    echo "$(tr_msg ports_logic2)"
    echo
    read -r -p "$(tr_msg ports_prompt)" ports_in
    ports_in="$(trim "$ports_in")"
    case "$ports_in" in
      0) return 0 ;;
      00) return 0 ;;
    esac
    if [[ -z "$ports_in" ]]; then
      selected_ports="${DEFAULT_PORTS[*]}"
    else
      selected_ports="$ports_in"
    fi

    cleaned=""
    for p in $selected_ports; do
      if valid_port "$p"; then
        cleaned="$cleaned $p"
      else
        warn "$(tr_msg bad_port_skip): $p"
      fi
    done
    cleaned="${cleaned# }"
    if [[ -z "$cleaned" ]]; then
      err "$(tr_msg no_valid_ports)"
      sleep 1
      continue
    fi
    final_ports="$(uniq_ports "$cleaned")"
    break
  done

  cls
  add_rules_for_ports "$target_ip" "$proto_choice" "$final_ports"
  pause
}

antizapret_menu() {
  safe_mkdir_files
  local target_ip sel ports mode
  while true; do
    cls
    say "${GREEN}AntizapretVPN by GubernievS${RESET}"
    echo "$(tr_msg antizapret_note)"
    echo
    read -r -p "$(tr_msg target_ip_prompt)" target_ip
    target_ip="$(trim "$target_ip")"
    case "$target_ip" in
      0|00) return 0 ;;
    esac
    valid_ip "$target_ip" && break
    err "$(tr_msg invalid_ip)"
    sleep 1
  done

  while true; do
    cls
    say "${GREEN}AntizapretVPN preset${RESET}"
    echo "1) $(tr_msg recommended): OpenVPN TCP+UDP, WireGuard/AmneziaWG UDP"
    echo "2) All preset ports TCP+UDP"
    echo "3) UDP only"
    echo "4) TCP only"
    echo "0) $(tr_msg back)"
    echo "00) $(tr_msg main_menu)"
    echo
    read -r -p "$(tr_msg choose_item)" sel
    case "$(trim "$sel")" in
      1)
        cls
        add_rules_for_ports "$target_ip" "both" "${ANTIZAPRET_OPENVPN_PORTS[*]}"
        add_rules_for_ports "$target_ip" "udp" "${ANTIZAPRET_WG_PORTS[*]}"
        pause
        return 0
        ;;
      2) ports="${ANTIZAPRET_PORTS[*]}"; mode="both"; break ;;
      3) ports="${ANTIZAPRET_PORTS[*]}"; mode="udp"; break ;;
      4) ports="${ANTIZAPRET_PORTS[*]}"; mode="tcp"; break ;;
      0|00) return 0 ;;
      *) err "$(tr_msg invalid_choice)"; sleep 1 ;;
    esac
  done
  cls
  add_rules_for_ports "$target_ip" "$mode" "$ports"
  pause
}

delete_rule_menu() {
  safe_mkdir_files
  cls
  if [[ ! -s "$STATE_FILE" ]]; then
    warn "$(tr_msg no_rules)"
    pause
    return 0
  fi
  print_rules
  echo
  local nums filtered n tmp
  read -r -p "$(tr_msg delete_prompt)" nums
  nums="$(trim "$nums")"
  case "$nums" in
    0|00) return 0 ;;
  esac
  [[ -z "$nums" ]] && { warn "$(tr_msg numbers_missing)"; pause; return 0; }
  filtered=""
  for n in $nums; do
    if [[ "$n" =~ ^[0-9]+$ ]]; then
      filtered="$filtered $n"
    else
      warn "$(tr_msg bad_port_skip): $n"
    fi
  done
  filtered="${filtered# }"
  [[ -z "$filtered" ]] && { warn "$(tr_msg numbers_missing)"; pause; return 0; }

  tmp="$(mktemp)"
  cp "$STATE_FILE" "$tmp"
  awk -v nums="$filtered" '
    BEGIN { split(nums,a," "); for (i in a) del[a[i]]=1 }
    { if (!del[NR]) print $0 }
  ' "$tmp" > "$STATE_FILE"
  rm -f "$tmp"
  apply_rules
  success "$(tr_msg delete_done)"
  pause
}

delete_all_menu() {
  safe_mkdir_files
  cls
  print_rules
  echo
  local confirm
  read -r -p "$(tr_msg confirm_delete_all)" confirm
  if [[ "$confirm" != "YES" ]]; then
    warn "$(tr_msg canceled)"
    pause
    return 0
  fi
  : > "$STATE_FILE"
  apply_rules
  success "$(tr_msg delete_all_done)"
  pause
}

check_tcp_port() {
  local host="$1" port="$2"
  if cmd_exists nc; then
    nc -z -w 2 "$host" "$port" >/dev/null 2>&1
    return $?
  fi
  timeout 2 bash -c "</dev/tcp/$host/$port" >/dev/null 2>&1
}

check_udp_port() {
  local host="$1" port="$2"
  if cmd_exists nc; then
    nc -z -u -w 2 "$host" "$port" >/dev/null 2>&1
    return $?
  fi
  return 2
}

ports_check_menu() {
  local host proto_choice ports_in ports cleaned p
  while true; do
    cls
    say "${GREEN}$(tr_msg check_port_title)${RESET}"
    read -r -p "$(tr_msg check_target_prompt)" host
    host="$(trim "$host")"
    case "$host" in
      0|00) return 0 ;;
    esac
    [[ -n "$host" ]] && break
  done
  proto_choice="$(choose_protocol)"
  [[ "$proto_choice" == "back" || "$proto_choice" == "main" ]] && return 0
  cls
  read -r -p "$(tr_msg ports_prompt)" ports_in
  ports_in="$(trim "$ports_in")"
  case "$ports_in" in
    0|00) return 0 ;;
  esac
  [[ -z "$ports_in" ]] && ports_in="${ANTIZAPRET_PORTS[*]}"
  cleaned=""
  for p in $ports_in; do
    valid_port "$p" && cleaned="$cleaned $p"
  done
  ports="${cleaned# }"
  [[ -z "$ports" ]] && { err "$(tr_msg no_valid_ports)"; pause; return 0; }

  cls
  echo "Host: $host"
  echo "Ports: $ports"
  echo
  if [[ "$proto_choice" == "tcp" || "$proto_choice" == "both" ]]; then
    say "${BLUE}TCP${RESET}"
    for p in $ports; do
      if check_tcp_port "$host" "$p"; then
        success "TCP $p: $(tr_msg open)"
      else
        warn "TCP $p: $(tr_msg closed)"
      fi
    done
    echo
  fi
  if [[ "$proto_choice" == "udp" || "$proto_choice" == "both" ]]; then
    say "${BLUE}UDP${RESET}"
    warn "$(tr_msg udp_note)"
    for p in $ports; do
      if check_udp_port "$host" "$p"; then
        success "UDP $p: $(tr_msg open) / possible"
      else
        warn "UDP $p: unknown or $(tr_msg closed)"
      fi
    done
  fi
  pause
}

apply_tuning() {
  require_root
  cat > /etc/sysctl.d/99-proxy-udp.conf <<'EOF_SYSCTL'
# Proxy UDP recommended parameters
net.ipv4.ip_forward=1
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_mtu_probing=1
net.netfilter.nf_conntrack_max=1048576
net.netfilter.nf_conntrack_udp_timeout=15
net.netfilter.nf_conntrack_udp_timeout_stream=60
net.netfilter.nf_conntrack_tcp_timeout_established=7200
net.core.netdev_max_backlog=10000
net.core.netdev_budget=600
net.core.netdev_budget_usecs=8000
net.core.somaxconn=4096
net.ipv4.tcp_max_syn_backlog=4096
net.ipv4.tcp_syncookies=1
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.default.rp_filter=0
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.default.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.default.send_redirects=0
EOF_SYSCTL
  modprobe nf_conntrack >/dev/null 2>&1 || true
  sysctl --system >/dev/null || true
  success "$(tr_msg done)"
}

show_conntrack() {
  echo "nf_conntrack_count: $(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo n/a)"
  echo "nf_conntrack_max:   $(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo n/a)"
  echo "udp_timeout:        $(cat /proc/sys/net/netfilter/nf_conntrack_udp_timeout 2>/dev/null || echo n/a)"
  echo "udp_timeout_stream: $(cat /proc/sys/net/netfilter/nf_conntrack_udp_timeout_stream 2>/dev/null || echo n/a)"
  if cmd_exists conntrack; then
    echo
    conntrack -S 2>/dev/null || true
  fi
}

nat_settings_menu() {
  local sel ipaddr
  while true; do
    cls
    conf_load
    say "${GREEN}$(tr_msg nat_settings)${RESET}"
    echo "Current NAT mode: ${NAT_MODE}"
    echo "SNAT IP: ${SNAT_IP:-auto}"
    echo
    echo "1) MASQUERADE (dynamic IP)"
    echo "2) SNAT (static IP)"
    echo "0) $(tr_msg back)"
    echo "00) $(tr_msg main_menu)"
    echo
    read -r -p "$(tr_msg choose_item)" sel
    case "$(trim "$sel")" in
      1) NAT_MODE="masquerade"; SNAT_IP=""; conf_save; apply_rules; success "$(tr_msg done)"; pause; return 0 ;;
      2)
        read -r -p "SNAT source IPv4, Enter for auto-detected: " ipaddr
        ipaddr="$(trim "$ipaddr")"
        if [[ -n "$ipaddr" ]] && ! valid_ip "$ipaddr"; then
          err "$(tr_msg invalid_ip)"; sleep 1; continue
        fi
        NAT_MODE="snat"; SNAT_IP="$ipaddr"; conf_save; apply_rules; success "$(tr_msg done)"; pause; return 0
        ;;
      0|00) return 0 ;;
      *) err "$(tr_msg invalid_choice)"; sleep 1 ;;
    esac
  done
}

settings_menu() {
  local sel
  while true; do
    cls
    say "${GREEN}$(tr_msg diag_title)${RESET}"
    echo "1) $(tr_msg apply_tuning)"
    echo "2) $(tr_msg show_conntrack)"
    echo "3) $(tr_msg nat_settings)"
    echo "4) $(tr_msg change_language)"
    echo "0) $(tr_msg back)"
    echo "00) $(tr_msg main_menu)"
    echo
    read -r -p "$(tr_msg choose_item)" sel
    case "$(trim "$sel")" in
      1) cls; apply_tuning; pause ;;
      2) cls; show_conntrack; pause ;;
      3) nat_settings_menu ;;
      4) choose_language ;;
      0|00) return 0 ;;
      *) err "$(tr_msg invalid_choice)"; sleep 1 ;;
    esac
  done
}

install_quick_command() {
  require_root
  ensure_prereqs
  local tmp=""
  if cmd_exists wget; then
    tmp="$(mktemp)"
    if wget -qO "$tmp" --inet4-only "${SELF_URL}?$(date +%s)"; then
      install -m 755 "$tmp" "$QUICK_CMD"
      rm -f "$tmp"
    else
      rm -f "$tmp"
      if [[ -r "$0" ]]; then
        install -m 755 "$0" "$QUICK_CMD"
      else
        err "Could not download or copy script."
        exit 1
      fi
    fi
  elif [[ -r "$0" ]]; then
    install -m 755 "$0" "$QUICK_CMD"
  else
    err "wget not found and current script is not readable."
    exit 1
  fi

  cat > "$SERVICE_FILE" <<EOF_SERVICE
[Unit]
Description=Proxy UDP rules auto-apply
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$QUICK_CMD apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF_SERVICE

  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable proxy-udp.service >/dev/null 2>&1 || true
  success "$(tr_msg quick_installed)"
  success "$(tr_msg service_installed)"
}

status_command() {
  ensure_language
  safe_mkdir_files
  conf_load
  local wan
  wan="$(detect_wan_if 2>/dev/null || true)"
  echo "$APP_NAME $VERSION"
  echo "$(tr_msg wan_if): ${wan:-unknown}"
  echo "$(tr_msg rules_file): $STATE_FILE"
  echo "Config: $CONF_FILE"
  echo "NAT: $NAT_MODE ${SNAT_IP:-}"
  echo
  print_rules
  echo
  show_conntrack || true
}

show_header() {
  local wan
  wan="$(detect_wan_if 2>/dev/null || true)"
  say "${GREEN}${BOLD}$APP_NAME${RESET} ${CYAN}v$VERSION${RESET}"
  echo "$(tr_msg wan_if): ${wan:-unknown}"
  echo "$(tr_msg rules_file): $STATE_FILE"
  echo
}

main_menu() {
  require_root
  ensure_prereqs
  safe_mkdir_files
  ensure_language
  conf_load
  apply_rules >/dev/null 2>&1 || true

  local c
  while true; do
    cls
    show_header
    say "${GREEN}$(tr_msg main_menu_title)${RESET}"
    echo "1) $(tr_msg create_proxy)"
    echo "2) $(tr_msg antizapret_preset)"
    echo "3) $(tr_msg delete_selected)"
    echo "4) $(tr_msg delete_all)"
    echo "5) $(tr_msg show_rules)"
    echo "6) $(tr_msg check_ports)"
    echo "7) $(tr_msg settings_diag)"
    echo "8) $(tr_msg install_quick)"
    echo "0) $(tr_msg exit)"
    echo
    read -r -p "$(tr_msg choose_item)" c
    case "$(trim "$c")" in
      1) create_proxy_menu ;;
      2) antizapret_menu ;;
      3) delete_rule_menu ;;
      4) delete_all_menu ;;
      5) cls; print_rules; pause ;;
      6) ports_check_menu ;;
      7) settings_menu ;;
      8) cls; install_quick_command; pause ;;
      0) cls; exit 0 ;;
      *) err "$(tr_msg invalid_choice)"; sleep 1 ;;
    esac
  done
}

case "${1:-}" in
  install-go)
    safe_mkdir_files
    ensure_language
    install_quick_command
    ;;
  apply)
    safe_mkdir_files
    ensure_language
    apply_rules
    success "$(tr_msg rules_applied)"
    ;;
  status)
    status_command
    ;;
  tune)
    safe_mkdir_files
    ensure_language
    apply_tuning
    ;;
  --help|-h|help)
    cat <<EOF_HELP
Proxy UDP $VERSION

Usage:
  sudo ./proxy-udp             Open menu
  sudo ./proxy-udp install-go  Install quick command: proxy-go
  sudo proxy-go                Open menu after installation
  sudo proxy-go apply          Apply saved rules
  sudo proxy-go status         Show status
  sudo proxy-go tune           Apply high-load sysctl tuning
EOF_HELP
    ;;
  *)
    main_menu
    ;;
esac
